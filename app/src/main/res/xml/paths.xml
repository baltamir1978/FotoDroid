<?xml version="1.0" encoding="utf-8"?>
<!--
  Para compartir archivos que MediaStore no tiene (carpetas con .nomedia, ocultas…): sólo el
  almacenamiento compartido (el interno y los volúmenes extraíbles), no todo el sistema de archivos.
-->
<paths>
    <external-path name="interno" path="." />
    <root-path name="volumenes" path="storage/" />
</paths>
